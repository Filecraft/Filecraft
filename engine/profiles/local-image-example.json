{
  "version": 1,
  "id": "local-image-example",
  "description": "Illustrative personal limits only. Not an institution-issued or verified profile.",
  "constraints": {
    "formats": [
      "png",
      "jpeg"
    ],
    "bytes": {
      "max": 2097152
    },
    "pageCount": {
      "min": 1,
      "max": 1
    },
    "dimensions": {
      "unit": "px",
      "minWidth": 1,
      "maxWidth": 4096,
      "minHeight": 1,
      "maxHeight": 4096
    },
    "filename": {
      "extensions": [
        "png",
        "jpg",
        "jpeg"
      ],
      "maxLength": 120
    }
  }
}
