{
  "version": 1,
  "id": "local-pdf-example",
  "description": "Illustrative local checklist. PDF structure/page evidence needs a platform adapter.",
  "constraints": {
    "formats": [
      "pdf"
    ],
    "bytes": {
      "max": 10485760
    },
    "pageCount": {
      "min": 1,
      "max": 10
    },
    "filename": {
      "extensions": [
        "pdf"
      ],
      "maxLength": 120
    }
  }
}
