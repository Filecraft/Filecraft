{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local document constraints v1",
  "description": "Runtime additionally enforces min <= max and bounded UTF-8 input; no institutional certification implied.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [],
          "minProperties": 1
        },
        "pageCount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [],
          "minProperties": 1
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "png",
              "jpeg",
              "pdf"
            ]
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": {
              "enum": [
                "px",
                "pt"
              ]
            },
            "minWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "minHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "unit"
          ],
          "minProperties": 2
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape",
            "square"
          ]
        },
        "filename": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extensions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]{1,10}$"
              }
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "asciiOnly": {
              "type": "boolean"
            }
          },
          "required": [],
          "minProperties": 1
        }
      },
      "required": []
    }
  },
  "required": [
    "version",
    "id",
    "constraints"
  ]
}
