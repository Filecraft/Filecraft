{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dry-run page workflow v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "steps": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "duplicate"
              },
              "pageIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            },
            "required": [
              "op",
              "pageIds"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "delete"
              },
              "pageIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            },
            "required": [
              "op",
              "pageIds"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "reorder"
              },
              "pageIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            },
            "required": [
              "op",
              "pageIds"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "rotate"
              },
              "pageIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "degrees": {
                "enum": [
                  90,
                  180,
                  270,
                  -90,
                  -180,
                  -270
                ]
              }
            },
            "required": [
              "op",
              "pageIds",
              "degrees"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "extract"
              },
              "pageIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            },
            "required": [
              "op",
              "pageIds"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "steps"
  ]
}
